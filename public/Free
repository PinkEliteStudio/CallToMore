<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="description" content="Free printable: 7 Restoration Scriptures to speak over your life. Print them, place them where you'll see them, and let God restore what was lost. From Call To More.">
    <meta name="author" content="Rhina Delgado">
    <meta property="og:title" content="Free: 7 Restoration Scriptures — Call To More">
    <meta property="og:description" content="Declarations to speak over your life when you're waiting on God to restore.">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://raw.githubusercontent.com/PinkEliteStudio/CallToMore/main/public/scriptures-cover.png">
    <title>Free: 7 Restoration Scriptures | Call To More</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@400;500;600&display=swap');
        .logo { height: 88px; max-width: 260px; width: auto; object-fit: contain; }
        @media (max-width: 768px) { .logo { height: 62px; } }
        .title-font { font-family: 'Playfair Display', serif; font-weight: 900; letter-spacing: -0.02em; }
        .section-title { font-family: 'Playfair Display', serif; font-weight: 700; }
        .hover-pink { transition: all 0.3s ease; }
        .hover-pink:hover { color: #F472B6; transform: translateY(-2px); }
        #ctm-success { display: none; }
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-[#FFF0F5] text-gray-800">

    <!-- HEADER (identical to your homepage) -->
    <header class="bg-white shadow-md fixed top-0 w-full z-50">
        <div class="container mx-auto px-6 py-2 flex items-center justify-between">
            <a href="/"><img src="https://raw.githubusercontent.com/PINKEliteStudio/vividassistpro/main/calltomorelogo.png"
                 alt="Call To More" class="logo"></a>

            <nav class="hidden md:flex items-center space-x-7 text-sm font-medium">
                <a href="/#home" class="hover-pink">Home</a>
                <a href="/#message" class="hover-pink">My Story</a>
                <a href="/#inside" class="hover-pink">What's Inside</a>
                <a href="/#seeking-room" class="hover-pink">Get the Planner</a>
                <a href="/#book" class="hover-pink">Book</a>
                <a href="/free.html" class="hover-pink font-semibold text-[#F472B6]">Free Download</a>
                <a href="/#contact" class="hover-pink">Connect</a>
            </nav>

            <a href="/#seeking-room"
               class="hidden md:block bg-[#F472B6] hover:bg-pink-600 text-white px-6 py-2.5 rounded-full font-medium transition-all text-sm">
                Get The Seeking Room — $17
            </a>

            <button id="menu-toggle" class="md:hidden text-gray-700 focus:outline-none" aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>

        <div id="mobile-menu" class="hidden md:hidden bg-white border-t">
            <div class="px-6 py-6 flex flex-col space-y-5 text-base">
                <a href="/#home" class="hover-pink">Home</a>
                <a href="/#message" class="hover-pink">My Story</a>
                <a href="/#inside" class="hover-pink">What's Inside</a>
                <a href="/#seeking-room" class="hover-pink">Get the Planner</a>
                <a href="/#book" class="hover-pink">Book</a>
                <a href="/free.html" class="hover-pink font-semibold text-[#F472B6]">Free Download</a>
                <a href="/#contact" class="hover-pink">Connect</a>
                <a href="/#seeking-room" class="bg-[#F472B6] text-white px-6 py-3 rounded-full text-center font-medium">
                    Get The Seeking Room — $17
                </a>
            </div>
        </div>
    </header>

    <!-- HERO -->
    <section class="pt-40 md:pt-32 pb-16 px-6 bg-[#f7cce3]">
        <div class="container mx-auto grid md:grid-cols-2 gap-12 items-center max-w-6xl">
            <div>
                <span class="inline-block bg-[#B8860B] text-white text-xs font-bold tracking-widest px-5 py-2 rounded-full mb-6">FREE PRINTABLE</span>
                <h1 class="title-font text-4xl md:text-5xl leading-tight text-[#DB2777] mb-6">
                    7 Restoration<br>Scriptures
                    <span class="block italic font-normal text-gray-800" style="font-family:'Playfair Display',serif;">to speak over your life</span>
                </h1>
                <p class="text-lg text-gray-700 mb-6">When you're waiting on God to restore what was lost, His Word is where you stand.</p>
                <ul class="space-y-3 text-gray-700">
                    <li class="flex items-start gap-3"><span class="text-[#B8860B] text-xl leading-none">&#10022;</span> 7 restoration Scriptures with a spoken declaration for each</li>
                    <li class="flex items-start gap-3"><span class="text-[#B8860B] text-xl leading-none">&#10022;</span> Print them, cut them out, place them on your mirror or wall</li>
                    <li class="flex items-start gap-3"><span class="text-[#B8860B] text-xl leading-none">&#10022;</span> Read them out loud each morning &mdash; and watch what shifts</li>
                </ul>
            </div>

            <div class="bg-white rounded-3xl shadow-2xl border border-[#f7cce3] p-8 md:p-10">
                <div id="ctm-form-wrap">
                    <h2 class="section-title text-2xl text-[#DB2777] text-center mb-2">Get your free Scriptures</h2>
                    <p class="text-center text-sm text-gray-500 mb-6">Enter your email and I'll send them straight to your inbox.</p>

                    <!-- KIT FORM — replace FORM_ID (3 places) with your new Kit form number -->
                    <form id="ctm-free-form"
                          action="https://app.kit.com/forms/FORM_ID/subscriptions"
                          method="post" data-sv-form="FORM_ID" data-uid="FORM_ID" class="space-y-3">
                        <input type="text" name="fields[first_name]" placeholder="First Name" autocomplete="given-name"
                               class="w-full px-5 py-4 rounded-xl border border-[#f7cce3] bg-[#FFFBF7] focus:outline-none focus:ring-2 focus:ring-[#F472B6]">
                        <input type="email" name="email_address" placeholder="Your Email Address" required autocomplete="email"
                               class="w-full px-5 py-4 rounded-xl border border-[#f7cce3] bg-[#FFFBF7] focus:outline-none focus:ring-2 focus:ring-[#F472B6]">
                        <button type="submit"
                                class="w-full bg-[#DB2777] hover:bg-[#F472B6] text-white font-bold py-4 rounded-full transition-all text-lg">
                            SEND MY FREE SCRIPTURES
                        </button>
                    </form>
                    <p class="text-center text-xs text-gray-400 mt-4">No spam. Unsubscribe anytime.</p>
                </div>

                <div id="ctm-success" class="text-center py-6">
                    <h2 class="section-title text-2xl text-[#DB2777] mb-3">Check your inbox! &#128151;</h2>
                    <p class="text-gray-700">Your 7 Restoration Scriptures are on the way. If you don't see the email in a minute, check your promotions or spam folder.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- PREVIEW -->
    <section class="bg-white py-16 px-6">
        <div class="container mx-auto max-w-4xl text-center">
            <h3 class="section-title text-3xl text-[#DB2777] mb-3">What you're getting</h3>
            <p class="text-gray-700 max-w-xl mx-auto mb-10">A beautifully designed printable you'll actually want on your wall. Speak these over your season &mdash; there is power in declaring God's Word out loud.</p>
            <div class="flex gap-6 justify-center flex-wrap">
                <img src="https://raw.githubusercontent.com/PinkEliteStudio/CallToMore/main/public/scriptures-cover.png" alt="7 Restoration Scriptures cover" class="w-64 rounded-xl shadow-lg border border-[#f7cce3]">
                <img src="https://raw.githubusercontent.com/PinkEliteStudio/CallToMore/main/public/scriptures-cards.png" alt="Restoration Scripture cards" class="w-64 rounded-xl shadow-lg border border-[#f7cce3]">
            </div>
        </div>
    </section>

    <!-- FOOTER (matches your homepage footer style) -->
    <footer class="bg-gray-950 text-gray-400 py-14">
        <div class="container mx-auto px-6 text-center">
            <div class="flex justify-center mb-6">
                <img src="https://raw.githubusercontent.com/PINKEliteStudio/vividassistpro/main/calltomorelogo.png"
                     alt="Call To More" class="h-20 object-contain">
            </div>
            <p class="text-sm">&copy; 2026 Rhina Delgado &bull; Call To More. All rights reserved.</p>
            <p class="text-xs mt-4">
                <a href="/" class="hover:text-gray-300">calltomoreandyou.com</a> &middot;
                <a href="https://instagram.com/calltomore" class="hover:text-gray-300">@calltomore</a>
            </p>
        </div>
    </footer>

    <script>
        document.getElementById('menu-toggle').addEventListener('click', function () {
            document.getElementById('mobile-menu').classList.toggle('hidden');
        });
        (function () {
            var form = document.getElementById('ctm-free-form');
            if (!form) return;
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                fetch(form.action, { method: 'POST', body: new FormData(form), mode: 'no-cors' })
                    .then(function () {
                        document.getElementById('ctm-form-wrap').style.display = 'none';
                        document.getElementById('ctm-success').style.display = 'block';
                    })
                    .catch(function () { form.submit(); });
            });
        })();
    </script>
</body>
</html>
